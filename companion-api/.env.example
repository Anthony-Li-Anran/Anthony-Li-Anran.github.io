# Set these as environment variables; this file is not automatically loaded.
STELLE_ORIGINS=http://127.0.0.1:4181,http://localhost:4181
# Production: point to the generated site's assets/stelle-knowledge.json.
# STELLE_KNOWLEDGE=/srv/stelle/data/stelle-knowledge.json
# STELLE_DB=/srv/stelle/data/budget.sqlite
# Owner mode stays disabled unless key AND positive budgets/rate are supplied.
STELLE_OWNER_PROVIDER=deepseek
STELLE_OWNER_MODEL=deepseek-v4-flash
STELLE_OWNER_KEY=
STELLE_DAILY_CNY=0
STELLE_MONTHLY_CNY=0
# Must cover the most expensive input/output token rate of the selected model.
# Verify actual provider pricing before enabling; this is NOT a quoted price.
STELLE_MAX_CNY_PER_MILLION=0
